<div class="max-w-[800px] mx-auto px-4 md:px-0">
     <div class="flex flex-wrap justify-center gap-8 md:gap-6 scale-75 md:scale-100">
        {% for item in component.products_types %}
        <a
            href="{{item.url}}"
            class="flex flex-col items-center text-white text-center transition-transform duration-300 ease-in-out hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-primary border-primary"
        >
            <div class="w-24 h-24 rounded-full overflow-hidden border-2 border-primary mb-4 shadow-md transition-shadow hover:shadow-lg">
                <img
                    src="{{item.image}}"
                    alt="{{component.title}}"
                    class="w-full h-full object-cover"
                />
            </div>
            <span class="text-base font-medium mt-2">{{ item.title }}</span>
        </a>
        {% endfor %}
    </div>
</div>
