{# Header component for responsive design #} {% set important_links =
theme.settings.get('important_links') %}
<header class="store-header">
  {# Main Nav #}
  <div id="mainnav" class="main-nav-container bg-[#1C2029] rounded-b-xl">
    <div class="inner py-2 bg-[#1C2029] rounded-b-2xl">
      <div class="container bg-[#1C2029] mx-auto rounded-b-xl">
        <div class="flex items-center justify-between relative">
          {# Mobile menu button #}
          {% if advertisement.icon %}
          <span class="{{ advertisement.icon }}"></span>
        {% endif %}
        {% if advertisement.url %}
          <a href="{{ advertisement.url }}" {% if advertisement.is_new_window %} target='_blank' {% endif %}>
            {{ advertisement.description }}
          </a>
        {% else %}
          {{ advertisement.description }}
        {% endif %}     <div class="flex items-center lg:flex-1">
            <salla-menu source="header">
           
            </salla-menu>   <button
                class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4"
                aria-label="Toggle menu"
                onclick="salla.event.dispatch('menu::open')"
              >
                <i class="sicon-menu text-white text-2xl"></i>
              </button>
          </div>

          {# Logo #}
          <div class="flex-1 flex items-center justify-center">
            <a href="{{ store.url }}" class="mx-auto">
              <img
                fetchpriority="high"
                width="100"
                height="100"
                loading="eager"
                src="{{ store.logo }}"
                alt="{{ store.name }} logo"
                class="mx-auto h-16 w-auto"
              />
              {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
              {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
              {% endif %}
            </a>
          </div>

          {# Cart and user menu #}
          <div class="flex items-center justify-end lg:flex-1 lg:ml-4">
            <div class="relative mr-4">
              <salla-cart-summary class="header-cart no-summary hydrated">
                <img
                  slot="icon"
                  src="{{ 'images/cart.png' | asset }}"
                  alt="Cart"
                  class="w-[30px] tint"
                />
                <span
                  slot="badge"
                  class="absolute -top-2 -right-2 bg-primary text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"
                >
                  {{ cart.items_count }}
                </span>
              </salla-cart-summary>
            </div>

            <div class="hidden lg:block">
              <salla-user-menu avatar-only show-header></salla-user-menu>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

{# Mobile menu #}
<div id="mobile-menu" class="fixed inset-0 bg-[#1C2029] z-50 hidden">
  <div class="container mx-auto py-4">
    <button
      onclick="toggleMobileMenu()"
      class="text-white text-2xl absolute top-4 right-4"
    >
      &times;
    </button>
    <nav class="mt-12">
      <salla-menu source="header" use-react-link="true"></salla-menu>
    </nav>
  </div>
</div>

{% if store.scope %}
<salla-scopes
  selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"
></salla-scopes>
{% endif %} {# Bottom navigation for mobile #}
<nav
  class="lg:hidden fixed bottom-2 left-0 right-0 bg-[#1C2029] text-white z-50 shadow-lg w-[90%] mx-auto rounded-2xl "
>
  <div class="flex items-center justify-around h-[60px]">
    <a href="{{ store.url }}" class="flex flex-col items-center">
      <img
        src="{{ 'images/home.png' | asset }}"
        alt="Home"
        class="w-6 h-6 tint mb-1"
      />
    </a>
    <button
      class="flex flex-col items-center"
      aria-label="Search"
      onclick="salla.event.dispatch('search::open')"
    >
      <img
        src="{{ 'images/search.png' | asset }}"
        alt="Search"
        class="w-6 h-6 tint mb-1"
      />
    </button>
    <div class="relative mr-4">
      <salla-cart-summary class="header-cart no-summary hydrated">
        <img
          slot="icon"
          src="{{ 'images/cart.png' | asset }}"
          alt="Cart"
          class="w-[30px] tint"
        />
        <span
          slot="badge"
          class="absolute -top-2 -right-2 bg-primary text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"
        >
          {{ cart.items_count }}
        </span>
      </salla-cart-summary>
    </div>
    {% if user.type == 'user' %}
    <salla-user-menu avatar-only show-header> </salla-user-menu>
    {% else %}
    <button
      class="flex flex-col items-center"
      aria-label="Login"
      onclick="salla.event.dispatch('login::open')"
    >
      <img
        src="{{ 'images/login.png' | asset }}"
        alt="Login"
        class="w-6 h-6 tint mb-1"
      />
    </button>
    {% endif %}
  </div>
</nav>

<script>
  function toggleMobileMenu() {
    const mobileMenu = document.getElementById("mobile-menu");
    mobileMenu.classList.toggle("hidden");
  }
</script>
