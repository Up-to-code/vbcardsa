<div class="top-navbar">
  <div class="container flex justify-between">
    <div class="flex-1 flex items-center gap-2">
      { Footer Menu } {% if important_links %}
      <salla-menu source="footer" topnav></salla-menu>
      {% endif %} { Language & Currency Component }
      <div class="header-buttons">
        {% if store.settings.is_multilingual or
        store.settings.currencies_enabled %}
        <button
          type="button"
          onclick="salla.event.dispatch('localization::open')"
          class="btn--rounded-gray basis-0"
        >
          <span
            class="flag iti__flag iti__{{ user.language.country_code }} rounded-sm"
          ></span>
          <span class="mx-1.5">|</span> <span>{{ currency.symbol }}</span>
        </button>
        <salla-localization-modal></salla-localization-modal>
        {% endif %}
      </div>

      { Scopes | Branches } {% if store.scope %}
      <button
        class="btn--rounded-gray"
        onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})"
      >
        <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
      </button>
      {% endif %} { Search bar }
      <div class="header-search flex-1">
        <salla-search inline oval height="36"></salla-search>
      </div>
    </div>

    <salla-contacts is-header></salla-contacts>
  </div>
</div>
#} {% set important_links = theme.settings.get('important_links') %}
<header class="store-header">
  {# Main Nav #}
  <div id="mainnav" class="main-nav-container bg-[#1C2029] rounded-b-xl">
    <div class="inner py-2">
      <div class="container bg-[#1C2029] mx-auto w-[90%] rounded-md">
        <div class="flex items-center justify-between relative">
          <div class="flex items-center  lg:flex-1">
            <a
              class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4"
              href="#mobile-menu"
              aria-label="Open-menu"
            >
              <i class="sicon-menu text-primary text-2xl"></i>
            </a>
            <div class="hidden lg:block lg:ml-4">
              <salla-menu
                source="header"
                topnav="true"
                use-react-link="true"
              ></salla-menu>
            </div>
          </div>

          <div class="flex-1 flex items-center justify-center  ">
            <a href="{{ store.url }}" class="mx-auto">
              <img
                fetchpriority="high"
                width="100%"
                height="100%"
                loading="eager"
                src="{{ store.logo }}"
                alt="{{ store.name }} logo"
                class="mx-auto h-16"
              />
              {% if is_page('index') %}
              <h1 class="sr-only">{{ store.name }}</h1>
              {% else %}
              <h2 class="sr-only">{{ store.name }}</h2>
              {% endif %}
            </a>
          </div>

          <div class="flex items-center justify-end lg:flex-1 lg:ml-4">
            {# Cart Summary #}
            <salla-cart-summary class="header-cart no-summary hydrated">
              <i slot="icon" class="header-btn__icon icon sicon-cart"></i>
            </salla-cart-summary>
            <div class="hidden lg:block lg:mr-4">
              <salla-user-menu avatar-only show-header></salla-user-menu>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>















{% if store.scope %}
<salla-scopes
  selection="{{ store.scope.display_as == 'popup' ? 'mandatory' : 'optional' }}"
></salla-scopes>
{% endif %}
<div
  class="fixed bottom-0 right-0 w-full h-[60px] bg-[#1C2029] text-white z-50 flex items-center justify-around"
>
  <div>
    <a href="{{ store.url }}">
      <img src="{{ 'images/home.png' | asset }}" alt="" class="w-8 tint" />
    </a>
  </div>
  <div>
    <button
      class="header-btn"
      aria-label="search-icon"
      onclick="salla.event.dispatch('search::open')"
    >
      <img
        src="{{ 'images/search.png' | asset }}"
        alt="Search"
        class="w-6 tint"
      />
    </button>
  </div>
  <div>
    <div class="flex items-center justify-end">
      {# Cart Summary #}
      <salla-cart-summary class="header-cart no-summary hydrated">
        <i slot="icon" class="header-btn__icon icon sicon-cart"></i>
      </salla-cart-summary>
    </div>
  </div>
  <div>
    {# User Menu (if applicable) #} {% if user.type == 'user' %}

    <salla-user-menu avatar-only show-header></salla-user-menu>

    {% else %}
    <button
      class="header-btn"
      aria-label="user-icon"
      onclick="salla.event.dispatch('login::open')"
    >
      <img
        src="{{ 'images/login.png' | asset }}"
        alt=""
        class="w-8 tint r-180"
      />
    </button>
    {% endif %}
  </div>
</div>
