<footer class="store-footer pb-[60px] md:pb-0 px-5 bg-gray-900 text-white">
  <div aria-label="footer" class="store-footer__inner">
    <div
      class="container grid grid-cols-1 lg:grid-cols-6 gap-8 lg:gap-6 justify-center md:justify-start"
    >
      <!-- Store Information -->
      <div class="lg:col-span-2 ltr:lg:pr-20 rtl:lg:pl-20">
        <div class="mx-5">
          {% if store.logo %}
          <div class="flex items-center justify-center md:justify-start mb-4">
            <img
              class="w-full max-w-20 md:max-w-24"
              loading="lazy"
              src="{{ store.logo }}"
              data-src="{{ 'images/logo.png' | cdn(70,70) }}"
              alt="{{ store.name }}"
            />
          </div>
          {% else %}
          <div class="flex items-center justify-center md:justify-start mb-4">
            <a href="{{ store.url }}" class="w-full max-w-20 md:max-w-24">
              <h2 class="text-lg font-bold">{{ store.name }}</h2>
            </a>
          </div>
          {% endif %} {% if store.description %}
          <div class="flex items-center justify-center md:justify-start mb-4">
            <p
              class="max-w-sm leading-6 mb-6 text-center md:text-start text-gray-300"
            >
              {{ store.description | raw }}
            </p>
          </div>
          {% endif %}
        </div>

        <!-- Social Links -->
        <div class="flex items-center justify-center md:justify-start">
          <salla-social></salla-social>
        </div>

        <!-- VAT Section -->
        {% if store.settings.tax.number %}
        <div class="flex items-center mt-4 space-x-2 rtl:space-x-reverse">
          {% if store.settings.tax.certificate %}
          <a
            class="load-img-onclick"
            data-modal-id="modal-value-tax"
            href="#/"
            alt="{{ store.settings.tax.number }}"
          >
            <img
              width="100%"
              height="100%"
              src="{{ 'images/s-empty.png' | cdn }}"
              data-src="{{ 'images/tax.png' | cdn(70,70) }}"
              class="lazy w-10 rounded-sm hover:opacity-80 transition-opacity"
              alt="value added tax"
            />
          </a>
          {% endif %}
          <div>
            <p class="text-sm text-gray-400">
              {{ trans("common.elements.tax_number") }}
            </p>
            <b class="text-sm">{{ store.settings.tax.number }}</b>
          </div>
        </div>

        {% if store.settings.tax.certificate %}
        <salla-modal
          sub-title-first
          sub-title="{{ trans('common.elements.tax_number') }}"
          modal-title="{{ store.settings.tax.number }}"
          id="modal-value-tax"
        >
          <div class="flex justify-center max-w-full">
            <img
              class="w-full"
              loading="lazy"
              src="{{ 'images/s-empty.png' | cdn }}"
              data-src="{{ store.settings.tax.certificate }}"
              alt="{{ store.settings.tax.number }}"
            />
          </div>
        </salla-modal>
        {% endif %} {% endif %}
      </div>

      <!-- Links Section -->
      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-lg font-semibold mb-4">
          {{ trans("blocks.footer.pages_links") }}
        </h3>
        <salla-menu source="footer"></salla-menu>
      </div>

      <!-- Client Links -->
      <div
        class="lg:col-span-3 w-full flex flex-row items-center justify-center gap-2 flex-wrap"
      >
        {% for i in theme.settings.get('claints') %}
        <a
          href="{{ i.url }}"
          target="_blank"
          class="flex flex-col items-center justify-center p-2 bg-zinc-950 rounded-md shadow hover:bg-zinc-800 transition duration-300 w-18 h-18 md:w-20 md:h-20"
        >
          <div class="flex flex-col items-center justify-center py-2">
            <div class="icone">
              <i
                class="{{ i.icon_picker }} text-primary text-lg md:text-xl"
              ></i>
            </div>
            <p class="text-[10px] text-gray-400 text-center md:text-xs">
              {{ i.string }}
            </p>
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="container">
    <div
      class="md:flex items-center justify-between py-4 text-center border-t border-gray-700"
    >
      <span class="text-sm text-gray-400 copyright-text"
        >{% hook copyright %}</span
      >
      <salla-payments></salla-payments>
    </div>
  </div>
</footer>
