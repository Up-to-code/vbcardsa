<div class="faq-container">
    <h2 class="faq-title w-[90%] m-auto">{{ component.title }}</h2>
    {% for item in component.questions %}
    <div class="question">
      <div class="question-title">
        <span class="arrow"></span> {{ item.title }}
      </div>
      <div class="question-text">
        {{ item.body }}
      </div>
    </div>
    {% endfor %}
  </div>
  
  {% block styles %}
  <style>
    .faq-container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      font-family: Arial, sans-serif;
    }
  
    .question {
      background-color: #1c1c1f;
      border-radius: 10px;
      margin: 10px 0;
      overflow: hidden;
      transition: background-color 0.3s ease;
      width: 90%;
      margin: 10px auto;
    }
  
    .question-title {
      cursor: pointer;
      font-size: 18px;
      color: #fff;
      padding: 15px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: background-color 0.3s ease, padding 0.3s ease;
    }
  
    .question-title:hover {
      background-color: #2c2c31;
      padding: 15px 25px;
    }
  
    .arrow {
      border: solid #fff;
      border-width: 0 3px 3px 0;
      display: inline-block;
      padding: 5px;
      transform: rotate(45deg);
      transition: transform 0.3s ease;
    }
  
    .question-title.active .arrow {
      transform: rotate(-135deg);
    }
  
    .question-text {
      padding: 0 20px 20px 20px;
      background-color: #2c2c31;
      border-radius: 10px;
      color: #fff;
      display: none;
      font-size: 16px;
      line-height: 1.5;
    }
  
    .question-text.show {
      display: block;
      animation: fadeIn 0.3s ease-in-out;
    }
  
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
  </style>
  {% endblock %}
  
  {% block scripts %}
  <script>
  onload = async function () {
      const questionTitles = document.querySelectorAll('.question-title');
  
      questionTitles.forEach(title => {
          title.addEventListener('click', function () {
              const bodyText = this.nextElementSibling;
  
              this.classList.toggle('active');
  
              if (bodyText.classList.contains('show')) {
                  bodyText.classList.remove('show');
              } else {
                  document.querySelectorAll('.question-text').forEach(text => {
                      text.classList.remove('show');
                  });
                  bodyText.classList.add('show');
              }
          });
      });
  };
  </script>
  {% endblock %}
  