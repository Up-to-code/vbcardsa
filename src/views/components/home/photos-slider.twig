<section
  class="s-block home-slider s-block--hero-slider s-block--full-bg wide-placeholder container relative z-9999 bg-transparent"
  data-wow-delay="0.1s"
  style="background-color: transparent;"
>
  <salla-slider
    id="main-slider-3"
    class="home-slider main-slider round s-slider-wrapper fullwidth-slider s-slider-has-notitle s-slider-v-centered s-slider-horizontal hydrated"
    auto-play=""
    loop=""
    show-controls="false"
    type="fullwidth"
    slider-config='{"effect": "flip", "speed": 500, "autoplay": true}'
    direction="rtl"
  >
    <div slot="items">
      {% for item in items %}
      <div class="w-full h-full relative"> <!-- Position relative to contain the absolute elements -->
        <a href="{{ item.url }}" class="block w-full h-full relative">
          <img
            loading="eager"
            src="{{ item.image.url }}"
            alt="{{ item.image.alt }}"
            class="absolute top-0 left-0 w-full h-full object-cover rounded-xl"
           />
        </a>
      </div>
      {% endfor %}
    </div>
  </salla-slider>
</section>
