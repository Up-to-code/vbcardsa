<div class=" max-w-[800px] mx-auto font-sans bg-[#1c1c1f] rounded-lg p-6 shadow-lg my-12 w-[90%] rounded-xl ">
  <h3 class="text-2xl font-bold text-white mb-6 text-center">{{ component.title }}</h3>
  <div class="flex flex-wrap justify-around gap-6">
    {% for item in component.m %}
    <a
      href="{{item.url}}"
      class="flex flex-col items-center text-white text-center transition-transform duration-300 ease-in-out hover:scale-105"
    >
      <div class="w-20 h-20 rounded-full overflow-hidden border-2 border-primary mb-3 shadow-md">
        <img
          src="{{item.image}}"
          alt="{{component.title}}"
          class="w-full h-full object-cover"
        />
      </div>
      <span class="text-sm font-medium">{{ item.title }}</span>
    </a>
    {% endfor %}
  </div>
</div>
